# expo-router arrastra dependencias de su versión web (vaul, radix) que piden
# react-dom 19.2.8, mientras que el SDK 57 fija react 19.2.3. npm 10 aborta ante
# ese conflicto aunque en un móvil ese árbol web no se usa nunca. Sin esto,
# cualquier `npm install` posterior falla con ERESOLVE.
legacy-peer-deps=true
