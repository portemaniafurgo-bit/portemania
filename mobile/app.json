{
  "expo": {
    "name": "ClicyVoy",
    "slug": "clicyvoy",
    "owner": "clicyvoys-team",
    "scheme": "clicyvoy",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clicyvoy.app"
    },
    "android": {
      "package": "com.clicyvoy.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "ClicyVoy comparte tu posición con el cliente mientras tienes un servicio en curso, también con la pantalla bloqueada o mientras navegas con Google Maps.",
          "locationWhenInUsePermission": "ClicyVoy usa tu posición para calcular rutas y tiempos de llegada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ClicyVoy necesita acceso a tus fotos para adjuntar imágenes de la carga.",
          "cameraPermission": "ClicyVoy necesita la cámara para fotografiar la carga y los documentos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7145d6"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true,
          "merchantIdentifier": "merchant.com.clicyvoy.app"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1df4daf7-0c6a-401b-94bc-ff0b3fe65493"
      }
    }
  }
}
