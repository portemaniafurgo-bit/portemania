{
  "expo": {
    "name": "ClicyVoy",
    "slug": "clicyvoy",
    "owner": "clicyvoys-team",
    "scheme": "clicyvoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clicyvoy.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": ["es"]
      }
    },
    "android": {
      "package": "com.clicyvoy.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "ClicyVoy guarda tu sesión de forma protegida en este iPhone. No usa Face ID para nada más."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "ClicyVoy recoge tu ubicación para que el cliente pueda seguirte en el mapa y saber cuándo llegas, también con la pantalla bloqueada o mientras navegas con otra app. Solo se comparte mientras tienes un servicio activo y se detiene al terminarlo o al cancelarlo.",
          "locationWhenInUsePermission": "ClicyVoy usa tu ubicación para rellenar la dirección de recogida y, si eres conductor, para que el cliente te siga en el mapa mientras tienes un servicio activo.",
          "locationAlwaysPermission": "ClicyVoy recoge tu ubicación para que el cliente pueda seguirte en el mapa y saber cuándo llegas, también con la pantalla bloqueada o mientras navegas con otra app. Solo se comparte mientras tienes un servicio activo y se detiene al terminarlo o al cancelarlo.",
          "motionUsagePermission": "ClicyVoy no utiliza los datos de movimiento de tu iPhone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ClicyVoy necesita acceso a tus fotos para adjuntar imágenes de la carga.",
          "cameraPermission": "ClicyVoy necesita la cámara para fotografiar la carga y los documentos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7145d6",
          "icon": "./assets/notification-icon.png",
          "sounds": ["./assets/sounds/oferta.wav"]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true,
          "merchantIdentifier": "merchant.com.clicyvoy.app"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 230,
          "backgroundColor": "#7145d6"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1df4daf7-0c6a-401b-94bc-ff0b3fe65493"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1df4daf7-0c6a-401b-94bc-ff0b3fe65493"
    }
  }
}
